@page "/Account/Login"
@attribute [ExcludeFromInteractiveRouting]
@attribute [AllowAnonymous]
@attribute [EnableRateLimiting("auth")]
@layout AuthLayout

@using System.ComponentModel.DataAnnotations
@using CvPlatform.Web.Resources
@using Microsoft.AspNetCore.Authentication

@inject SignInManager<ApplicationUser> SignInManager
@inject NavigationManager Navigation
@inject IStringLocalizer<SharedResource> L

<PageTitle>@L["Login"]</PageTitle>

<MudPaper Elevation="2" Class="cv-auth-card">
    <MudText Typo="Typo.h5" Class="mb-1">@L["Login"]</MudText>
    <MudText Typo="Typo.body2" Class="cv-text-secondary mb-4">@L["LoginHelper"]</MudText>

    @if (!string.IsNullOrEmpty(StatusMessage))
    {
        <MudAlert Severity="Severity.Error" Class="mb-4">@StatusMessage</MudAlert>
    }

    <EditForm Model="Input" method="post" OnValidSubmit="LoginUser" FormName="login">
        <DataAnnotationsValidator />
        <ValidationSummary />
        <div class="cv-field">
            <label class="cv-label" for="login-email">@L["Email"]</label>
            <InputText id="login-email" class="cv-input" @bind-Value="Input!.Email" autocomplete="username" />
            <ValidationMessage class="cv-validation" For="() => Input!.Email" />
        </div>
        <div class="cv-field">
            <label class="cv-label" for="login-password">@L["Password"]</label>
            <InputText id="login-password" type="password" class="cv-input" @bind-Value="Input!.Password" autocomplete="current-password" />
            <ValidationMessage class="cv-validation" For="() => Input!.Password" />
        </div>
        <label class="cv-remember">
            <InputCheckbox @bind-Value="Input!.RememberMe" />
            <span>@L["RememberMe"]</span>
        </label>
        <button type="submit" class="cv-submit">@L["Login"]</button>
    </EditForm>

    @if (_externalLogins.Count > 0)
    {
        <MudDivider Class="my-4" DividerType="DividerType.FullWidth" />
        <MudText Typo="Typo.body2" Class="cv-text-secondary mb-2">@L["ExternalLoginPrompt"]</MudText>
        <div class="cv-oauth-row">
            @foreach (var provider in _externalLogins)
            {
                var loginUrl = $"/Account/ExternalLogin?provider={Uri.EscapeDataString(provider.Name)}&returnUrl={Uri.EscapeDataString(ReturnUrl ?? "/")}";
                <MudButton Href="@loginUrl" Variant="Variant.Outlined" Class="cv-oauth-btn">
                    @provider.DisplayName
                </MudButton>
            }
        </div>
    }

    <MudText Typo="Typo.body2" Class="mt-4">
        <a href="/Account/Register?returnUrl=@Uri.EscapeDataString(ReturnUrl ?? "/")">@L["RegisterNewAccount"]</a>
    </MudText>
</MudPaper>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm(FormName = "login")]
    private InputModel? Input { get; set; }

    [SupplyParameterFromQuery]
    private string? ReturnUrl { get; set; }

    [SupplyParameterFromQuery(Name = "error")]
    private string? Error { get; set; }

    private string? StatusMessage;
    private IList<AuthenticationScheme> _externalLogins = [];

    protected override async Task OnInitializedAsync()
    {
        Input ??= new();

        if (!string.IsNullOrEmpty(Error))
            StatusMessage = Error switch
            {
                "noemail" => L["ExternalNoEmail"],
                "createfailed" => L["ExternalCreateFailed"],
                "externallinkrequired" => L["ExternalLinkRequired"],
                "providerunavailable" or "providererror" => L["ExternalLoginUnavailable"],
                "lockedout" => L["AccountLockedOut"],
                "twofactor" => L["TwoFactorRequired"],
                "notallowed" => L["ExternalLoginNotAllowed"],
                _ => L["ExternalLoginUnavailable"],
            };

        if (HttpMethods.IsGet(HttpContext.Request.Method))
        {
            await HttpContext.SignOutAsync(IdentityConstants.ExternalScheme);
            _externalLogins = (await SignInManager.GetExternalAuthenticationSchemesAsync()).ToList();
        }
    }

    private async Task LoginUser()
    {
        var result = await SignInManager.PasswordSignInAsync(Input!.Email, Input!.Password, Input!.RememberMe, lockoutOnFailure: false);
        if (result.Succeeded)
        {
            Navigation.NavigateTo(RedirectUrlHelper.SafeReturnUrl(ReturnUrl));
        }
        else if (result.IsNotAllowed)
        {
            Input!.Password = string.Empty;
            StatusMessage = L["EmailNotConfirmed"];
        }
        else
        {
            Input!.Password = string.Empty;
            StatusMessage = L["InvalidCredentials"];
        }
    }

    private sealed class InputModel
    {
        [Required]
        [EmailAddress]
        public string Email { get; set; } = "";

        [Required]
        [DataType(DataType.Password)]
        public string Password { get; set; } = "";

        public bool RememberMe { get; set; }
    }
}
