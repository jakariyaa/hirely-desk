@page "/Account/Register"
@attribute [ExcludeFromInteractiveRouting]
@attribute [AllowAnonymous]
@attribute [EnableRateLimiting("auth")]
@layout AuthLayout

@using System.ComponentModel.DataAnnotations
@using CvPlatform.Core.Data
@using CvPlatform.Application.Authorization
@using CvPlatform.Web.Resources

@inject UserManager<ApplicationUser> UserManager
@inject SignInManager<ApplicationUser> SignInManager
@inject IAppDbContextFactory DbFactory
@inject CvPlatform.Core.Email.IAppEmailSender EmailSender
@inject NavigationManager Navigation
@inject IStringLocalizer<SharedResource> L

<PageTitle>@L["Register"]</PageTitle>

<MudPaper Elevation="2" Class="cv-auth-card">
    <MudText Typo="Typo.h5" Class="mb-1">@L["Register"]</MudText>
    <MudText Typo="Typo.body2" Class="cv-text-secondary mb-4">@L["RegisterHelper"]</MudText>

    @if (!string.IsNullOrEmpty(StatusMessage))
    {
        <MudAlert Severity="Severity.Error" Class="mb-4">@StatusMessage</MudAlert>
    }

    @if (!string.IsNullOrEmpty(InfoMessage))
    {
        <MudAlert Severity="Severity.Info" Class="mb-4">@InfoMessage</MudAlert>
    }

    <EditForm Model="Input" method="post" OnValidSubmit="RegisterUser" FormName="register">
        <DataAnnotationsValidator />
        <ValidationSummary />
        <div class="cv-field">
            <label class="cv-label" for="register-email">@L["Email"]</label>
            <InputText id="register-email" class="cv-input" @bind-Value="Input!.Email" autocomplete="email" />
            <ValidationMessage class="cv-validation" For="() => Input!.Email" />
        </div>
        <div class="cv-field">
            <label class="cv-label" for="register-password">@L["PasswordMinLength"]</label>
            <InputText id="register-password" type="password" class="cv-input" @bind-Value="Input!.Password" autocomplete="new-password" />
            <ValidationMessage class="cv-validation" For="() => Input!.Password" />
        </div>
        <button type="submit" class="cv-submit">@L["Register"]</button>
    </EditForm>

    <MudText Typo="Typo.body2" Class="mt-4">
        <a href="/Account/Login">@L["AlreadyHaveAccount"]</a>
    </MudText>
</MudPaper>

@code {
    [SupplyParameterFromForm(FormName = "register")]
    private InputModel? Input { get; set; }

    [SupplyParameterFromQuery]
    private string? ReturnUrl { get; set; }

    private string? StatusMessage;
    private string? InfoMessage;

    protected override void OnInitialized()
    {
        Input ??= new();
    }

    private async Task RegisterUser()
    {
        var user = new ApplicationUser { UserName = Input!.Email, Email = Input!.Email };
        var result = await UserManager.CreateAsync(user, Input!.Password);
        if (!result.Succeeded)
        {
            StatusMessage = string.Join(" ", result.Errors.Select(e => e.Description));
            return;
        }

        var roleResult = await UserManager.AddToRoleAsync(user, Roles.Candidate);
        if (!roleResult.Succeeded)
        {
            await UserManager.DeleteAsync(user);
            StatusMessage = string.Join(" ", roleResult.Errors.Select(e => e.Description));
            return;
        }

        using var db = DbFactory.CreateDbContext();
        db.Profiles.Add(new Profile { Id = Guid.NewGuid(), UserId = user.Id });
        await db.SaveChangesAsync();

        if (UserManager.Options.SignIn.RequireConfirmedAccount)
        {
            var token = await UserManager.GenerateEmailConfirmationTokenAsync(user);
            var link = Navigation.ToAbsoluteUri(
                $"/Account/ConfirmEmail?userId={user.Id}&token={Uri.EscapeDataString(token)}&returnUrl={Uri.EscapeDataString(RedirectUrlHelper.SafeReturnUrl(ReturnUrl))}").ToString();
            await EmailSender.SendConfirmationLinkAsync(user.Email!, link);
            InfoMessage = L["EmailConfirmationSent"];
            return;
        }

        await SignInManager.SignInAsync(user, isPersistent: false);
        Navigation.NavigateTo(RedirectUrlHelper.SafeReturnUrl(ReturnUrl));
    }

    private sealed class InputModel
    {
        [Required]
        [EmailAddress]
        public string Email { get; set; } = "";

        [Required]
        [StringLength(100, MinimumLength = 8)]
        [DataType(DataType.Password)]
        public string Password { get; set; } = "";
    }
}
