@page "/Account/Register"
@attribute [ExcludeFromInteractiveRouting]
@attribute [AllowAnonymous]
@attribute [EnableRateLimiting("auth")]
@layout AuthLayout

@using System.ComponentModel.DataAnnotations
@using CvPlatform.Core.Data
@using CvPlatform.Web.Resources

@inject UserManager<ApplicationUser> UserManager
@inject SignInManager<ApplicationUser> SignInManager
@inject IAppDbContextFactory DbFactory
@inject NavigationManager Navigation
@inject IStringLocalizer<SharedResource> L

<PageTitle>@L["Register"]</PageTitle>

<MudPaper Elevation="2" Class="cv-auth-card">
    <MudText Typo="Typo.h5" Class="mb-1">@L["Register"]</MudText>
    <MudText Typo="Typo.body2" Class="cv-text-secondary mb-4">@L["RegisterHelper"]</MudText>

    @if (!string.IsNullOrEmpty(StatusMessage))
    {
        <MudAlert Severity="Severity.Error" Class="mb-4">@StatusMessage</MudAlert>
    }

    <EditForm Model="Input" method="post" OnValidSubmit="RegisterUser" FormName="register" novalidate>
        <DataAnnotationsValidator />
        <ValidationSummary />
        <MudTextField T="string" Label="@L["Email"]" @bind-Value="Input.Email" For="() => Input.Email"
                      UserAttributes="@EmailAttributes"
                      Variant="Variant.Outlined" Class="mb-3" />
        <MudTextField T="string" Label="@L["PasswordMinLength"]" @bind-Value="Input.Password" For="() => Input.Password"
                      UserAttributes="@NewPasswordAttributes"
                      Variant="Variant.Outlined" InputType="InputType.Password" Class="mb-3" />
        <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" Class="mt-4"
                   ButtonType="ButtonType.Submit">@L["Register"]</MudButton>
    </EditForm>

    <MudText Typo="Typo.body2" Class="mt-4">
        <a href="/Account/Login">@L["AlreadyHaveAccount"]</a>
    </MudText>
</MudPaper>

@code {
    [SupplyParameterFromForm]
    private InputModel Input { get => _input ??= new(); set => _input = value; }
    private InputModel? _input;

    [SupplyParameterFromQuery]
    private string? ReturnUrl { get; set; }

    private string? StatusMessage;
    private static readonly Dictionary<string, object> EmailAttributes =
        new Dictionary<string, object> { ["autocomplete"] = "email" };
    private static readonly Dictionary<string, object> NewPasswordAttributes =
        new Dictionary<string, object> { ["autocomplete"] = "new-password" };

    private async Task RegisterUser()
    {
        var user = new ApplicationUser { UserName = Input.Email, Email = Input.Email };
        var result = await UserManager.CreateAsync(user, Input.Password);
        if (!result.Succeeded)
        {
            StatusMessage = string.Join(" ", result.Errors.Select(e => e.Description));
            return;
        }

        using var db = DbFactory.CreateDbContext();
        db.Profiles.Add(new Profile { Id = Guid.NewGuid(), UserId = user.Id });
        await db.SaveChangesAsync();

        await SignInManager.SignInAsync(user, isPersistent: false);
        Navigation.NavigateTo(RedirectUrlHelper.SafeReturnUrl(ReturnUrl));
    }

    private sealed class InputModel
    {
        [Required]
        [EmailAddress]
        public string Email { get; set; } = "";

        [Required]
        [StringLength(100, MinimumLength = 8)]
        [DataType(DataType.Password)]
        public string Password { get; set; } = "";
    }
}
