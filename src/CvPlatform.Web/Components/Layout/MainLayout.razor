@inherits LayoutComponentBase
@implements IDisposable

@using CvPlatform.Web.Components.Shared
@using CvPlatform.Web.Resources
@using CvPlatform.Web.Theme
@using CvPlatform.Application.Authorization
@using CvPlatform.Application.Profiles
@using CvPlatform.Web.Auth
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.Extensions.Localization
@using CvPlatform.Web.State

@inject AuthenticationStateProvider AuthState
@inject UserManager<ApplicationUser> Users
@inject IProfileService ProfileService
@inject ProfileHeaderState ProfileHeader
@inject Blazored.LocalStorage.ILocalStorageService Storage
@inject IJSRuntime JS
@inject NavigationManager Navigation
@inject IStringLocalizer<SharedResource> L

<MudThemeProvider Theme="@CvPlatformTheme.Instance" @bind-IsDarkMode="_darkMode" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout Class="cv-content-wrap">
    <MudAppBar Elevation="0" Color="Color.Surface" Class="cv-appbar">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start"
                       OnClick="ToggleDrawer" aria-label="@L["Navigation"]" />
        <MudLink Href="/" Underline="Underline.None" Class="cv-brand-home" aria-label="@L["Home"]">
            <img class="cv-brand-logo cv-brand-logo-appbar" src="/hirely-desk-logo.svg" alt="Hirely Desk" />
            <MudText Typo="Typo.h6" Class="cv-appbar-title d-none d-sm-inline">@L["AppName"]</MudText>
        </MudLink>
        <MudSpacer />
        <AuthorizeView>
            <Authorized>
                <GlobalSearch />
            </Authorized>
        </AuthorizeView>
        <MudIconButton Icon="@(_darkMode ? Icons.Material.Filled.LightMode : Icons.Material.Filled.DarkMode)"
                       Color="Color.Inherit" OnClick="ToggleTheme" title="@L["Theme"]" />
        <MudMenu Icon="@Icons.Material.Filled.Translate" Color="Color.Inherit" AriaLabel="@L["Language"]"
                 Class="cv-menu-actions">
            <MudMenuItem OnClick="@(() => SetLanguageAsync("en"))">English</MudMenuItem>
            <MudMenuItem OnClick="@(() => SetLanguageAsync("pl"))">Polski</MudMenuItem>
        </MudMenu>
        <AuthorizeView>
            <Authorized>
                <MudMenu Class="cv-menu-actions" Color="Color.Inherit" AriaLabel="@L["AccountMenu"]">
                    <ActivatorContent Context="menuCtx">
                        <div class="cv-user-chip" @onclick="@menuCtx.ToggleAsync" role="button" tabindex="0"
                             @onkeydown="@(async (KeyboardEventArgs e) => { if (e.Key == "Enter" || e.Key == " ") await menuCtx.ToggleAsync(); })"
                             aria-haspopup="menu">
                            @if (!string.IsNullOrWhiteSpace(_profileImageUrl))
                            {
                                <MudImage Src="@_profileImageUrl" Alt="@_displayName" Class="cv-avatar cv-avatar-image" />
                            }
                            else
                            {
                                <span class="cv-avatar" aria-hidden="true">@_initials</span>
                            }
                            <span class="cv-user-chip-name d-none d-lg-inline">@_displayName</span>
                            <MudIcon Icon="@Icons.Material.Filled.ArrowDropDown" Class="d-none d-lg-inline" />
                        </div>
                    </ActivatorContent>
                    <ChildContent>
                        <MudText Typo="Typo.subtitle1" Class="px-4 pt-2 pb-1">@_displayName</MudText>
                        <MudText Typo="Typo.caption" Class="px-4 pb-2 cv-text-caption">@_email</MudText>
                        <MudDivider DividerType="DividerType.FullWidth" />
                        <MudMenuItem Href="/profile" Icon="@Icons.Material.Filled.Person">@L["Profile"]</MudMenuItem>
                        <form method="post" action="/Account/Logout" class="cv-logout-form">
                            <AntiforgeryToken />
                            <MudButton ButtonType="ButtonType.Submit" StartIcon="@Icons.Material.Filled.Logout"
                                       Color="Color.Inherit" FullWidth="true" Class="justify-start px-4">@L["Logout"]</MudButton>
                        </form>
                    </ChildContent>
                </MudMenu>
            </Authorized>
            <NotAuthorized>
                <MudButton Href="/Account/Login" Variant="Variant.Text" Color="Color.Primary">@L["Login"]</MudButton>
                <MudButton Href="/Account/Register" Variant="Variant.Filled" Color="Color.Primary"
                           Class="ml-2 cv-hidden-xs">@L["Register"]</MudButton>
            </NotAuthorized>
        </AuthorizeView>
    </MudAppBar>
    <MudDrawer @bind-Open="_drawerOpen" Elevation="0" Variant="DrawerVariant.Responsive"
               Class="cv-drawer" Anchor="Anchor.Start" ClipMode="DrawerClipMode.Always">
        <NavMenu />
    </MudDrawer>
    <MudMainContent Class="cv-main">
        <MudContainer MaxWidth="MaxWidth.Large" Class="cv-page-container">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private string? _displayName;
    private string? _email;
    private bool _drawerOpen;
    private bool _darkMode;
    private string? _initials;
    private string? _profileImageUrl;

    private void ToggleDrawer() => _drawerOpen = !_drawerOpen;

    protected override void OnInitialized() => ProfileHeader.Changed += RefreshHeaderAsync;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        await LoadHeaderAsync();
        StateHasChanged();
    }

    private async Task LoadHeaderAsync()
    {
        var state = await AuthState.GetAuthenticationStateAsync();
        if (state.User.Identity?.IsAuthenticated == true)
        {
            var user = await Users.GetUserAsync(state.User);
            if (user is not null)
            {
                var actor = ActorContexts.FromUser(state.User);
                var summary = await ProfileService.GetSummaryForUserAsync(actor, actor.UserId);
                _displayName = summary.Succeeded && !string.IsNullOrWhiteSpace(summary.Value?.Name)
                    ? summary.Value.Name
                    : user.UserName;
                _email = user.Email;
                _profileImageUrl = summary.Succeeded ? summary.Value?.ImageUrl : null;
                _initials = BuildInitials(_displayName, user.Email);
            }
            ApplyTheme(user?.PreferredTheme);
        }
        else
        {
            var theme = await Storage.GetItemAsync<string>("cvplatform.theme");
            ApplyTheme(theme);
        }
    }

    private Task RefreshHeaderAsync() => InvokeAsync(async () =>
    {
        await LoadHeaderAsync();
        StateHasChanged();
    });

    public void Dispose() => ProfileHeader.Changed -= RefreshHeaderAsync;

    private static string BuildInitials(string? name, string? email)
    {
        var source = string.IsNullOrWhiteSpace(name) ? email : name;
        if (string.IsNullOrWhiteSpace(source))
            return "?";

        var parts = source.Split(new[] { ' ', '.', '_', '-', '@' }, StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length >= 2)
            return string.Concat(parts[0][0].ToString().ToUpperInvariant(), parts[1][0].ToString().ToUpperInvariant());
        return source.Substring(0, 1).ToUpperInvariant();
    }

    private void ApplyTheme(string? theme)
    {
        _darkMode = string.Equals(theme, "dark", StringComparison.OrdinalIgnoreCase);
    }

    private async Task ToggleTheme()
    {
        _darkMode = !_darkMode;
        var value = _darkMode ? "dark" : "light";

        var state = await AuthState.GetAuthenticationStateAsync();
        var user = state.User.Identity?.IsAuthenticated == true
            ? await Users.GetUserAsync(state.User)
            : null;

        if (user is not null)
        {
            user.PreferredTheme = value;
            await Users.UpdateAsync(user);
        }
        else
        {
            await Storage.SetItemAsync("cvplatform.theme", value);
        }
    }

    private async Task SetLanguageAsync(string lang)
    {
        var state = await AuthState.GetAuthenticationStateAsync();
        var user = state.User.Identity?.IsAuthenticated == true
            ? await Users.GetUserAsync(state.User)
            : null;

        if (user is not null)
        {
            user.PreferredLanguage = lang;
            await Users.UpdateAsync(user);
        }

        await JS.InvokeVoidAsync("cvPlatform.setCultureCookie", lang);
        Navigation.NavigateTo(Navigation.Uri, forceLoad: true);
    }
}
