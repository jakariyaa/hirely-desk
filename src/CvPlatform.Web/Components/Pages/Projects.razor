@page "/Profile/Projects"
@attribute [Authorize]
@using CvPlatform.Application.Common
@using CvPlatform.Application.Authorization
@using CvPlatform.Application.Projects
@using CvPlatform.Web.Components.Shared
@using CvPlatform.Web.Resources
@using Microsoft.Extensions.Localization
@using System.Security.Claims
@inject IProjectService ProjectService
@inject AuthenticationStateProvider AuthProvider
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject IStringLocalizer<SharedResource> L

<PageTitle>@L["Projects"]</PageTitle>

<PageHeader Title="@L["Projects"]" Subtitle="@L["ProjectsSubtitle"]" Icon="@Icons.Material.Filled.Work">
    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
               OnClick="OpenCreateDialogAsync" Disabled="@_loading">@L["NewProject"]</MudButton>
</PageHeader>

@if (_loading)
{
    <MudProgressLinear Color="Color.Primary" Indeterminate Class="cv-page-loading" />
}

@if (_error is not null)
{
    <EmptyState Icon="@Icons.Material.Filled.ErrorOutline" Title="@L["LoadFailed"]" Description="@_error">
        <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="@(async () => await LoadPageAsync(1))">@L["Retry"]</MudButton>
    </EmptyState>
}
else if (_page is { Items.Count: 0 })
{
    <EmptyState Icon="@Icons.Material.Filled.FolderOpen" Title="@L["NoProjects"]" Description="@L["NoProjectsHint"]">
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
                   OnClick="OpenCreateDialogAsync">@L["NewProject"]</MudButton>
    </EmptyState>
}
else if (_page is not null)
{
    <MudPaper Class="cv-panel pa-2">
        <MudDataGrid T="ProjectDto" Items="@_page.Items" ReadOnly Hover="true" Striped="true"
                     Dense="true" class="cv-projects-grid">
            <Columns>
                <PropertyColumn Property="p => p.Name" Title="@L["Name"]" />
                <TemplateColumn Title="@L["Period"]">
                    <CellTemplate>
                        <MudText Typo="Typo.body2" Style="white-space:nowrap">@FormatPeriod(context.Item)</MudText>
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn Title="@L["Tags"]">
                    <CellTemplate>
                        @if (context.Item.Tags.Count == 0)
                        {
                            <MudText Typo="Typo.caption">—</MudText>
                        }
                        else
                        {
                            <MudStack Row Spacing="1" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
                                @foreach (var tag in context.Item.Tags)
                                {
                                    <MudChip T="string" Size="Size.Small" Text="@tag" />
                                }
                            </MudStack>
                        }
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn Title="" Sortable="false" Filterable="false">
                    <CellTemplate>
                        <MudStack Row Spacing="1" Justify="Justify.FlexEnd">
                            <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Color="Color.Primary"
                                           Disabled="@_loading" title="@L["EditProject"]"
                                           OnClick="@(() => OpenEditDialogAsync(context.Item))" />
                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                                           Disabled="@_loading" title="@L["DeleteProject"]"
                                           OnClick="@(() => ConfirmDeleteAsync(context.Item))" />
                        </MudStack>
                    </CellTemplate>
                </TemplateColumn>
            </Columns>
        </MudDataGrid>
    </MudPaper>
    <MudStack Row Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mt-2">
        <MudSelect T="int" Value="@_pageSize" ValueChanged="@(async v => await HandlePageSizeChangedAsync(v))"
                   Variant="Variant.Outlined" Style="max-width:110px">
            <MudSelectItem Value="5">5</MudSelectItem>
            <MudSelectItem Value="10">10</MudSelectItem>
            <MudSelectItem Value="25">25</MudSelectItem>
        </MudSelect>
        <MudPagination Count="@Math.Max(1, _page.TotalPages)" Selected="@_page.Page"
                       SelectedChanged="@(async p => { if (p is int n) await LoadPageAsync(n); })" />
    </MudStack>

@code {
    private PagedResult<ProjectDto>? _page;
    private bool _loading;
    private string? _error;
    private int _pageSize = 10;

    protected override async Task OnInitializedAsync() => await LoadPageAsync(1);

    private async Task LoadPageAsync(int page)
    {
        _loading = true;
        _error = null;
        try
        {
            var actor = await GetActorAsync();
            var result = await ProjectService.ListForProfileAsync(
                actor, actor.UserId, new PageRequest(page, _pageSize));
            if (!result.Succeeded)
            {
                _error = result.Error.Message;
                _page = null;
                return;
            }

            _page = result.Value;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task HandlePageSizeChangedAsync(int pageSize)
    {
        _pageSize = pageSize;
        await LoadPageAsync(1);
    }

    private async Task OpenCreateDialogAsync()
    {
        var dialog = await DialogService.ShowAsync<ProjectEditDialog>(title: L["NewProject"]);
        var result = await dialog.Result;
        if (result is { Canceled: false, Data: ProjectDto })
            await RefreshCurrentPageAsync();
    }

    private async Task OpenEditDialogAsync(ProjectDto project)
    {
        var parameters = new DialogParameters
        {
            [nameof(ProjectEditDialog.Editing)] = project,
        };
        var dialog = await DialogService.ShowAsync<ProjectEditDialog>(title: L["EditProject"], parameters: parameters);
        var result = await dialog.Result;
        if (result is { Canceled: false, Data: ProjectDto })
            await RefreshCurrentPageAsync();
    }

    private async Task ConfirmDeleteAsync(ProjectDto project)
    {
        var parameters = new DialogParameters
        {
            [nameof(ConfirmDialog.ContentText)] = L["DeleteProjectConfirm"],
            [nameof(ConfirmDialog.YesText)] = L["Delete"],
            [nameof(ConfirmDialog.NoText)] = L["Cancel"],
        };
        var dialog = await DialogService.ShowAsync<ConfirmDialog>(title: L["DeleteProject"], parameters: parameters);
        var result = await dialog.Result;
        if (result is { Canceled: true } || result?.Data is not true)
            return;

        var actor = await GetActorAsync();
        var deleteResult = await ProjectService.DeleteAsync(actor, project.Id);
        if (deleteResult.Succeeded)
        {
            Snackbar.Add(L["ProjectDeleted"], Severity.Success);
            await RefreshCurrentPageAsync();
        }
        else
        {
            Snackbar.Add(deleteResult.Error.Message, Severity.Error);
        }
    }

    private async Task RefreshCurrentPageAsync()
    {
        var currentPage = _page?.Page ?? 1;
        if (_page is not null && _page.Items.Count == 1 && currentPage > 1)
            currentPage--;
        await LoadPageAsync(currentPage);
    }

    private static string FormatPeriod(ProjectDto project) => project switch
    {
        { PeriodStart: { } start, PeriodEnd: { } end } => $"{start:yyyy/MM} – {end:yyyy/MM}",
        { PeriodStart: { } start } => $"{start:yyyy/MM} – …",
        { PeriodEnd: { } end } => $"… – {end:yyyy/MM}",
        _ => "—",
    };

    private async Task<ActorContext> GetActorAsync()
    {
        var authState = await AuthProvider.GetAuthenticationStateAsync();
        return new ActorContext(
            Guid.Parse(authState.User.FindFirstValue(ClaimTypes.NameIdentifier)!),
            authState.User.IsInRole("Admin"));
    }
}

}
