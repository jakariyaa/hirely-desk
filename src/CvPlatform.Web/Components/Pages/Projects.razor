@page "/profile/projects"
@attribute [Authorize]
@using CvPlatform.Application.Common
@using CvPlatform.Application.Authorization
@using CvPlatform.Application.Projects
@using CvPlatform.Web.Components.Shared
@using CvPlatform.Web.Resources
@using Microsoft.Extensions.Localization
@using System.Security.Claims
@inject IProjectService ProjectService
@inject AuthenticationStateProvider AuthProvider
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject IStringLocalizer<SharedResource> L

<PageTitle>@L["Projects"]</PageTitle>

<PageHeader Title="@L["Projects"]" Subtitle="@L["ProjectsSubtitle"]" Icon="@Icons.Material.Filled.Work">
    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
               OnClick="OpenCreateDialogAsync" Disabled="@_loading">@L["NewProject"]</MudButton>
</PageHeader>

@if (_loading)
{
    <MudProgressLinear Color="Color.Primary" Indeterminate Class="cv-page-loading" />
}

@if (_error is not null)
{
    <EmptyState Icon="@Icons.Material.Filled.ErrorOutline" Title="@L["LoadFailed"]" Description="@_error">
        <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="@(async () => { if (_grid is not null) await _grid.ReloadServerData(); })">@L["Retry"]</MudButton>
    </EmptyState>
}
else
{
    <MudPaper Class="cv-panel cv-list-card pa-2">
    <MudDataGrid T="ProjectDto" ServerData="LoadServerDataAsync" @ref="_grid" Class="cv-list-table cv-projects-grid" ReadOnly Hover="true" Striped="true"
                 Dense="true" RowsPerPage="10" Loading="@_loading" MultiSelection="true"
                 @bind-SelectedItems="_selected" RowClick="OnRowClick">
        <ToolBarContent>
            <MudText Typo="Typo.h6">@L["Projects"]</MudText>
            <MudSpacer />
            <MudButton Variant="Variant.Outlined" Color="Color.Error" Disabled="@(_selected.Count != 1)"
                       OnClick="DeleteSelectedAsync">@L["Delete"]</MudButton>
        </ToolBarContent>
        <Columns>
                <SelectColumn T="ProjectDto" />
                <PropertyColumn Property="p => p.Name" Title="@L["Name"]" />
                <TemplateColumn Title="@L["Period"]">
                    <CellTemplate>
                        <MudText Typo="Typo.body2" Style="white-space:nowrap">@FormatPeriod(context.Item)</MudText>
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn Title="@L["Tags"]">
                    <CellTemplate>
                        @if (context.Item.Tags.Count == 0)
                        {
                            <MudText Typo="Typo.caption">—</MudText>
                        }
                        else
                        {
                            <MudStack Row Spacing="1" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
                                @foreach (var tag in context.Item.Tags)
                                {
                                    <MudChip T="string" Size="Size.Small" Text="@tag" />
                                }
                            </MudStack>
                        }
                    </CellTemplate>
                </TemplateColumn>
        </Columns>
            <NoRecordsContent>
                <MudStack AlignItems="AlignItems.Center" Class="pa-6">
                    <MudIcon Icon="@Icons.Material.Filled.FolderOpen" Size="Size.Large" />
                    <MudText Typo="Typo.h6">@L["NoProjects"]</MudText>
                    <MudText Typo="Typo.body2">@L["NoProjectsHint"]</MudText>
                </MudStack>
            </NoRecordsContent>
            <PagerContent>
                <MudDataGridPager T="ProjectDto" />
            </PagerContent>
        </MudDataGrid>
    </MudPaper>
}

@code {
    private MudDataGrid<ProjectDto>? _grid;
    private bool _loading;
    private string? _error;
    private HashSet<ProjectDto> _selected = [];

    private Task OnRowClick(DataGridRowClickEventArgs<ProjectDto> args) =>
        OpenEditDialogAsync(args.Item);

    private async Task<GridData<ProjectDto>> LoadServerDataAsync(GridState<ProjectDto> state, CancellationToken ct)
    {
        _loading = true;
        _error = null;
        try
        {
            var actor = await GetActorAsync();
            var result = await ProjectService.ListForProfileAsync(
                actor, actor.UserId, new PageRequest(state.Page + 1, state.PageSize), ct);
            if (!result.Succeeded)
            {
                _error = result.Error.Message;
                return new GridData<ProjectDto>();
            }

            return new GridData<ProjectDto>
            {
                TotalItems = result.Value.TotalCount,
                Items = result.Value.Items,
            };
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task OpenCreateDialogAsync()
    {
        var dialog = await DialogService.ShowAsync<ProjectEditDialog>(title: L["NewProject"]);
        var result = await dialog.Result;
        if (result is { Canceled: false, Data: ProjectDto } && _grid is not null)
            await _grid.ReloadServerData();
    }

    private async Task OpenEditDialogAsync(ProjectDto project)
    {
        var parameters = new DialogParameters
        {
            [nameof(ProjectEditDialog.Editing)] = project,
        };
        var dialog = await DialogService.ShowAsync<ProjectEditDialog>(title: L["EditProject"], parameters: parameters);
        var result = await dialog.Result;
        if (result is { Canceled: false, Data: ProjectDto } && _grid is not null)
            await _grid.ReloadServerData();
    }

    private async Task ConfirmDeleteAsync(ProjectDto project)
    {
        var parameters = new DialogParameters<ConfirmDialog>
        {
            { dialog => dialog.ContentText, L["DeleteProjectConfirm"].Value },
            { dialog => dialog.YesText, L["Delete"].Value },
            { dialog => dialog.NoText, L["Cancel"].Value },
        };
        var dialog = await DialogService.ShowAsync<ConfirmDialog>(title: L["DeleteProject"], parameters: parameters);
        var result = await dialog.Result;
        if (result is { Canceled: true } || result?.Data is not true)
            return;

        var actor = await GetActorAsync();
        var deleteResult = await ProjectService.DeleteAsync(actor, project.Id);
        if (deleteResult.Succeeded)
        {
            Snackbar.Add(L["ProjectDeleted"], Severity.Success);
            if (_grid is not null)
                await _grid.ReloadServerData();
        }
        else
        {
            Snackbar.Add(deleteResult.Error.Message, Severity.Error);
        }
    }

    private async Task DeleteSelectedAsync()
    {
        if (_selected.Count != 1)
            return;
        await ConfirmDeleteAsync(_selected.Single());
        _selected.Clear();
    }

    private static string FormatPeriod(ProjectDto project) => project switch
    {
        { PeriodStart: { } start, PeriodEnd: { } end } => $"{start:yyyy/MM} – {end:yyyy/MM}",
        { PeriodStart: { } start } => $"{start:yyyy/MM} – …",
        { PeriodEnd: { } end } => $"… – {end:yyyy/MM}",
        _ => "—",
    };

    private async Task<ActorContext> GetActorAsync()
    {
        var authState = await AuthProvider.GetAuthenticationStateAsync();
        return new ActorContext(Guid.Parse(authState.User.FindFirstValue(ClaimTypes.NameIdentifier)!), authState.User.IsInRole(Roles.Admin), authState.User.IsInRole(Roles.Recruiter) || authState.User.IsInRole(Roles.Admin));
    }
}
