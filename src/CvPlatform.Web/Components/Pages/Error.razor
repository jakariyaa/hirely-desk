@page "/Error"
@using System.Diagnostics
@using CvPlatform.Web.Resources
@using Microsoft.Extensions.Localization

@inject IStringLocalizer<SharedResource> L

<PageTitle>@L["ErrorPageTitle"]</PageTitle>

<div class="cv-state-page">
    <MudPaper Elevation="1" Class="cv-state-card" role="alert">
        <MudIcon Icon="@Icons.Material.Filled.ErrorOutline" Color="Color.Error" Size="Size.Large" />
        <MudText Typo="Typo.h5">@L["ErrorPageTitle"]</MudText>
        <MudText Typo="Typo.body1" Class="cv-text-secondary">@L["ErrorPageBody"]</MudText>

        @if (ShowRequestId)
        {
            <MudText Typo="Typo.body2" Class="cv-text-secondary">
                @L["ErrorReferenceId"]: <code>@RequestId</code>
            </MudText>
        }

        <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="/">@L["Home"]</MudButton>
    </MudPaper>
</div>

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }

    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}