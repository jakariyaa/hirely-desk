@page "/profile"
@attribute [Authorize]
@implements IAsyncDisposable
@using CvPlatform.Application.Attributes
@using CvPlatform.Application.Authorization
@using CvPlatform.Application.Common
@using CvPlatform.Application.Crm
@using CvPlatform.Application.Profiles
@using CvPlatform.Core.Enums
@using CvPlatform.Core.Entities
@using CvPlatform.Web.Components.Shared
@using CvPlatform.Web.Resources
@using CvPlatform.Web.State
@using Microsoft.AspNetCore.Authentication
@using Microsoft.AspNetCore.Components.Routing
@using Microsoft.AspNetCore.Identity
@using Microsoft.Extensions.Localization
@using System.Security.Claims
@using AppError = CvPlatform.Application.Common.Error
@inject IProfileService ProfileService
@inject ICrmSyncService CrmSyncService
@inject AuthenticationStateProvider AuthProvider
@inject IUiErrorReporter Errors
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject IStringLocalizer<SharedResource> L
@inject ProfileHeaderState ProfileHeader
@inject SignInManager<ApplicationUser> SignIn

<PageTitle>@L["Profile"]</PageTitle>

<PageHeader Title="@L["Profile"]" Subtitle="@L["ProfileSubtitle"]" Icon="@Icons.Material.Filled.Person" />

<NavigationLock ConfirmExternalNavigation="@HasUnsavedChanges"
                OnBeforeInternalNavigation="ConfirmLeaveAsync" />

@if (_loading)
{
    <MudProgressLinear Color="Color.Primary" Indeterminate Class="cv-page-loading" />
}

@if (LinkError is not null)
{
    <MudAlert Severity="Severity.Error" Class="mb-4">@LinkErrorMessage</MudAlert>
}

@if (_error is not null && _catalog is null)
{
    <EmptyState Icon="@Icons.Material.Filled.ErrorOutline" Title="@L["LoadFailed"]" Description="@_error">
        <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="LoadAsync">@L["Retry"]</MudButton>
    </EmptyState>
}
else if (_catalog is null)
{
    <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="180px" Class="mb-4" />
    <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="180px" />
}
else
{
    @if (_error is not null)
    {
        <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-4">@_error</MudAlert>
    }

    <div class="cv-profile-form">
        <MudPaper Class="cv-panel pa-4 mb-4 cv-profile-header">
            <div class="cv-profile-header-main">
                @if (_headerImageValueId is not null)
                {
                    <MudImage Src="@ImageContentUrl(_headerImageValueId.Value)" Alt="@HeaderName" Class="cv-profile-header-avatar" />
                }
                else
                {
                    <span class="cv-profile-header-avatar cv-profile-header-initials" aria-hidden="true">@HeaderInitials</span>
                }
                <div class="cv-profile-header-text">
                    <MudText Typo="Typo.h5">@HeaderName</MudText>
                    <MudText Typo="Typo.body2" Class="cv-text-caption">@_email</MudText>
                </div>
            </div>
            <div class="cv-profile-completion">
                <div class="cv-profile-completion-label">
                    <MudText Typo="Typo.caption">@L["ProfileCompletion"]</MudText>
                    <MudText Typo="Typo.caption">@CompletionPercent%</MudText>
                </div>
                <MudProgressLinear Color="Color.Primary" Size="Size.Small" Value="@CompletionPercent" />
            </div>
        </MudPaper>

        @if (PhotoDefinition is not null)
        {
            <MudPaper Class="cv-panel pa-4 mb-4 cv-profile-section" id="@AnchorFor(PhotoDefinition.Id)">
                <div class="cv-profile-section-head">
                    <div>
                        <MudText Typo="Typo.h6">@L["ProfilePhoto"]</MudText>
                        <MudText Typo="Typo.body2" Class="cv-text-caption">@L["ProfilePhotoHint"]</MudText>
                    </div>
                </div>
                <AttributeValueEditor Definition="PhotoDefinition"
                                       Value="@Draft(PhotoDefinition.Id)"
                                       Disabled="@IsSaving(PhotoDefinition.Id)"
                                       OnChanged="@(() => DraftChangedAsync(PhotoDefinition.Id))" />
            </MudPaper>
        }

        @foreach (var category in _catalog)
        {
            var definitions = DefinitionsOf(category);
            if (definitions.Count == 0)
            {
                continue;
            }

            <MudPaper Class="cv-panel pa-4 mb-4 cv-profile-section" id="@AnchorFor(category.Id)">
                <MudText Typo="Typo.h6" Class="mb-3">@category.Name</MudText>
                @foreach (var definition in definitions)
                {
                    <div class="cv-attribute-row">
                        <MudText Typo="Typo.body2" Class="cv-attribute-label">
                            @AttributeLabels.Localize(L, definition.Name)
                        </MudText>
                        <AttributeValueEditor Definition="definition"
                                               Value="@Draft(definition.Id)"
                                               Disabled="@IsSaving(definition.Id)"
                                               OnChanged="@(() => DraftChangedAsync(definition.Id))" />
                        <div class="cv-attribute-status">
                            @if (IsSaving(definition.Id))
                            {
                                <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                            }
                            else if (_dirty.Contains(definition.Id))
                            {
                                <MudIcon Icon="@Icons.Material.Filled.Schedule"
                                         Size="Size.Small"
                                         Color="Color.Warning"
                                         title="@L["ProfilePendingSave"]" />
                            }
                        </div>
                    </div>
                }
            </MudPaper>
        }

        <MudPaper Class="cv-panel pa-4 mb-4 cv-profile-section" id="@AccountAnchor">
            <MudText Typo="Typo.h6" Class="mb-1">@L["ProfileAccount"]</MudText>
            <MudText Typo="Typo.body2" Class="cv-text-caption mb-3">@L["ProfileExternalLoginsHint"]</MudText>
            @if (_externalSchemes.Count == 0)
            {
                <MudText Typo="Typo.body2">@L["ExternalLoginUnavailable"]</MudText>
            }
            else
            {
                <ExternalProviderButtons Providers="_externalSchemes"
                                         ReturnUrl="/profile"
                                         LinkMode="true"
                                         Color="Color.Primary"
                                         CssClass="d-flex flex-wrap gap-2"
                                         LabelFor="@(provider => L["LinkExternalProvider", provider.DisplayName ?? provider.Name])" />
            }
        </MudPaper>

        <MudPaper Class="cv-panel pa-4 mb-4 cv-profile-section">
            <MudText Typo="Typo.h6" Class="mb-1">@L["CrmSectionTitle"]</MudText>
            <MudText Typo="Typo.body2" Class="cv-text-caption mb-3">@L["CrmSectionHint"]</MudText>
            @if (_crmSynced)
            {
                <MudAlert Severity="Severity.Success" Dense="true">@L["CrmAlreadySynced"]</MudAlert>
            }
            else if (!CrmSyncService.IsConfigured)
            {
                <MudAlert Severity="Severity.Info" Dense="true">@L["CrmNotConfigured"]</MudAlert>
            }
            else
            {
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="OpenCrmSyncAsync">@L["CrmSyncButton"]</MudButton>
            }
        </MudPaper>
    </div>
}

@code {
    private const string AccountAnchor = "profile-section-account";
    private const int AutosaveDelayMilliseconds = 700;

    private IReadOnlyList<AttributeCategoryDto>? _catalog;
    private Dictionary<Guid, AttributeValueDraft> _drafts = [];
    private HashSet<Guid> _saving = [];
    private HashSet<Guid> _dirty = [];
    private readonly Dictionary<Guid, CancellationTokenSource> _autosave = [];
    private ActorContext? _actor;
    private IReadOnlyList<AuthenticationScheme> _externalSchemes = [];
    private bool _loading;
    private string? _error;
    private string? _displayName;
    private string? _email;
    private bool _crmSynced;
    private Guid? _headerImageValueId;

    [SupplyParameterFromQuery(Name = "error")]
    private string? LinkError { get; set; }

    private string LinkErrorMessage => LinkError switch
    {
        "provideralreadylinked" => L["ExternalProviderAlreadyLinked"].Value,
        "linkfailed" => L["ExternalProviderLinkFailed"].Value,
        _ => L["ExternalLoginUnavailable"].Value,
    };

    private AttributeDefinitionDto? PhotoDefinition => _catalog?
        .SelectMany(category => category.Definitions)
        .FirstOrDefault(definition => definition.Name == ProfileAttributeNames.Photo);

    private bool HasUnsavedChanges => _dirty.Count > 0;

    protected override async Task OnInitializedAsync()
    {
        _externalSchemes = (await SignIn.GetExternalAuthenticationSchemesAsync()).ToList();
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        await CancelPendingAutosavesAsync();
        _saving.Clear();
        _dirty.Clear();
        _loading = true;
        _error = null;
        try
        {
            var catalogResult = await ProfileService.GetCatalogAsync();
            if (!catalogResult.Succeeded)
            {
                _catalog = null;
                _error = Errors.Report(catalogResult.Error);
                return;
            }

            _catalog = catalogResult.Value;

            var actor = await GetActorAsync();
            var summary = await ProfileService.GetSummaryForUserAsync(actor, actor.UserId);
            if (summary.Succeeded)
            {
                _displayName = summary.Value?.Name;
                _headerImageValueId = summary.Value?.ImageValueId;
            }

            var authState = await AuthProvider.GetAuthenticationStateAsync();
            var user = await SignIn.UserManager.GetUserAsync(authState.User);
            _email = user?.Email;
            _crmSynced = await CrmSyncService.IsSyncedAsync(actor, actor.UserId);

            var profileResult = await ProfileService.GetForUserAsync(actor, actor.UserId);
            if (!profileResult.Succeeded)
            {
                _error = Errors.Report(profileResult.Error);
                return;
            }

            if (profileResult.Value is null)
                return;

            _drafts = profileResult.Value.Values.ToDictionary(
                value => value.AttributeDefinitionId, value => ToDraft(value));
        }
        finally
        {
            _loading = false;
        }
    }

    /// <summary>
    /// Definitions of a category, minus the photo, which is hoisted into its own card. Ordering
    /// puts the display name first, which is what people look for.
    /// </summary>
    private List<AttributeDefinitionDto> DefinitionsOf(AttributeCategoryDto category) =>
    [
        .. category.Definitions
            .Where(definition => definition.Name != ProfileAttributeNames.Photo)
            .OrderBy(definition => definition.Name == ProfileAttributeNames.Name ? 0 : 1)
            .ThenBy(definition => definition.Name)
    ];

    private static string AnchorFor(Guid id) => $"profile-section-{id:D}";

    private static string ImageContentUrl(Guid valueId) => $"/api/profile-images/{valueId:D}/content";

    private string HeaderName => !string.IsNullOrWhiteSpace(_displayName)
        ? _displayName
        : _email ?? L["Profile"].Value;

    private string HeaderInitials => Initials.From(_displayName, _email);

    private int CompletionPercent
    {
        get
        {
            if (_catalog is null)
                return 0;

            var definitions = _catalog.SelectMany(category => category.Definitions).ToList();
            if (definitions.Count == 0)
                return 0;

            var filled = definitions.Count(definition =>
                _drafts.TryGetValue(definition.Id, out var draft) && DraftHasValue(draft));
            return (int)Math.Round(100.0 * filled / definitions.Count);
        }
    }

    private static bool DraftHasValue(AttributeValueDraft draft) =>
        draft.ImageValueId is not null
        || draft.ImageObjectKey is not null
        || !string.IsNullOrWhiteSpace(draft.String)
        || !string.IsNullOrWhiteSpace(draft.Text)
        || draft.Numeric is not null
        || draft.Date is not null
        || draft.PeriodStart is not null
        || draft.PeriodEnd is not null
        || draft.Boolean is not null
        || !string.IsNullOrWhiteSpace(draft.Dropdown);

    private static AttributeValueDraft ToDraft(AttributeValueDto value) => new()
    {
        String = value.StringValue,
        Text = value.TextValue,
        Numeric = value.NumericValue,
        Date = value.DateValue,
        PeriodStart = value.PeriodStart,
        PeriodEnd = value.PeriodEnd,
        Boolean = value.BooleanValue,
        Dropdown = value.DropdownOption,
        ImageValueId = string.IsNullOrWhiteSpace(value.ImageObjectKey) ? null : value.ValueId,
        ImageObjectKey = value.ImageObjectKey,
        Version = value.Version,
    };

    private static AttributeValueInput ToInput(Guid definitionId, AttributeValueDraft draft) => new(
        definitionId,
        draft.String,
        draft.Text,
        draft.Numeric,
        draft.Date,
        draft.PeriodStart,
        draft.PeriodEnd,
        draft.Boolean,
        draft.Dropdown,
        draft.ImageObjectKey,
        draft.Version);

    private AttributeValueDraft Draft(Guid definitionId) =>
        _drafts.TryGetValue(definitionId, out var draft)
            ? draft
            : _drafts[definitionId] = new AttributeValueDraft();

    private bool IsSaving(Guid definitionId) => _saving.Contains(definitionId);

    private async Task DraftChangedAsync(Guid definitionId)
    {
        _dirty.Add(definitionId);
        StateHasChanged();

        if (_autosave.Remove(definitionId, out var previous))
            await previous.CancelAsync();

        var current = new CancellationTokenSource();
        _autosave[definitionId] = current;
        try
        {
            await Task.Delay(AutosaveDelayMilliseconds, current.Token);
            if (!IsSaving(definitionId) && _catalog is not null)
            {
                var definition = _catalog.SelectMany(category => category.Definitions)
                    .Single(candidate => candidate.Id == definitionId);
                await SaveAsync(definition);
            }
        }
        catch (OperationCanceledException) when (current.IsCancellationRequested)
        {
        }
        finally
        {
            if (_autosave.Remove(definitionId, out var completed))
                completed.Dispose();
        }
    }

    private async Task SaveAsync(AttributeDefinitionDto definition)
    {
        if (!_saving.Add(definition.Id))
            return;

        try
        {
            if (!_drafts.TryGetValue(definition.Id, out var draft))
                return;

            var actor = await GetActorAsync();
            var result = await ProfileService.SaveAttributeValueAsync(
                actor, actor.UserId, ToInput(definition.Id, draft));

            if (result.Succeeded)
            {
                if (result.Value is not null)
                {
                    var updated = result.Value.Values
                        .FirstOrDefault(value => value.AttributeDefinitionId == definition.Id);
                    if (updated is not null)
                        _drafts[definition.Id] = ToDraft(updated);
                }

                _dirty.Remove(definition.Id);
                Snackbar.Add(L["ProfileSaved"], Severity.Success);
                await ProfileHeader.NotifyChangedAsync();
                var refreshed = await ProfileService.GetSummaryForUserAsync(actor, actor.UserId);
                if (refreshed.Succeeded)
                {
                    _displayName = refreshed.Value?.Name ?? _displayName;
                    _headerImageValueId = refreshed.Value?.ImageValueId;
                }
                return;
            }

            await HandleSaveFailureAsync(result.Error);
        }
        catch (Exception ex)
        {
            Errors.Notify(ex);
        }
        finally
        {
            _saving.Remove(definition.Id);
        }
    }

    private async Task HandleSaveFailureAsync(AppError error)
    {
        if (error.Code != ErrorCodes.ConcurrencyConflict)
        {
            Errors.Notify(error);
            return;
        }

        var retry = await DialogService.ShowMessageBoxAsync(
            L["ConcurrencyConflictTitle"].Value,
            L["ProfileUnsavedChangesBody"].Value,
            yesText: L["Retry"].Value,
            cancelText: L["Cancel"].Value);
        if (retry == true)
            await LoadAsync();
    }

    private async Task ConfirmLeaveAsync(LocationChangingContext context)
    {
        // A pending autosave lands on its own, so only a field that is still waiting needs a prompt.
        if (!HasUnsavedChanges || _saving.Count > 0)
            return;

        var discard = await DialogService.ShowMessageBoxAsync(
            L["ProfileUnsavedChangesTitle"].Value,
            L["ProfileUnsavedChangesBody"].Value,
            yesText: L["ProfileDiscardChanges"].Value,
            cancelText: L["ProfileKeepEditing"].Value);

        if (discard == true)
            await CancelPendingAutosavesAsync();
        else
            context.PreventNavigation();
    }

    private async Task CancelPendingAutosavesAsync()
    {
        foreach (var source in _autosave.Values)
            await source.CancelAsync();

        foreach (var source in _autosave.Values)
            source.Dispose();

        _autosave.Clear();
    }

    private async Task OpenCrmSyncAsync()
    {
        var actor = await GetActorAsync();
        var parameters = new DialogParameters<SalesforceSyncDialog>
        {
            { x => x.Actor, actor },
            { x => x.UserId, actor.UserId },
        };
        var dialog = await DialogService.ShowAsync<SalesforceSyncDialog>(
            title: L["CrmSectionTitle"].Value, parameters: parameters);
        var result = await dialog.Result;
        if (result is { Canceled: false })
            _crmSynced = true;
    }

    private async Task<ActorContext> GetActorAsync()
    {
        if (_actor is not null)
            return _actor;

        var authState = await AuthProvider.GetAuthenticationStateAsync();
        return _actor = ActorContexts.FromUser(authState.User);
    }

    public async ValueTask DisposeAsync()
    {
        await CancelPendingAutosavesAsync();
        GC.SuppressFinalize(this);
    }
}
