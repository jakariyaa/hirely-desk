@page "/Admin/Attributes"
@attribute [Authorize(Roles = "Admin,Recruiter")]
@using CvPlatform.Application.Attributes
@using CvPlatform.Application.Authorization
@using CvPlatform.Application.Common
@using CvPlatform.Web.Components.Shared
@using CvPlatform.Web.Resources
@using Microsoft.Extensions.Localization
@using System.Security.Claims
@inject IAttributeCatalog Catalog
@inject IAttributeDefinitionService Definitions
@inject AuthenticationStateProvider AuthProvider
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject IStringLocalizer<SharedResource> L

<PageTitle>@L["AttributeCatalog"]</PageTitle>
<PageHeader Title="@L["AttributeCatalog"]" Subtitle="@L["AttributeCatalogSubtitle"]">
    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="CreateAsync">@L["NewAttribute"]</MudButton>
</PageHeader>

<MudTextField T="string" Value="_search" ValueChanged="SearchChangedAsync" Label="@L["Search"]" Immediate="true" Class="mb-3" />
@if (_page is null)
{
    <MudProgressLinear Indeterminate="true" />
}
else
{
    <MudTable Items="_page.Items" Class="cv-list-table" Hover="true" Dense="true" TableAttributes="@TableAttributes"
              MultiSelection="true" @bind-SelectedItems="_selected" SelectOnRowClick="false">
        <ToolBarContent>
            <MudText Typo="Typo.h6">@L["AttributeCatalog"]</MudText>
            <MudSpacer />
            <MudText Typo="Typo.caption" Class="mr-2">@L["SelectedCount", _selected.Count]</MudText>
            @if (_isAdmin)
            {
                <MudButton Variant="Variant.Outlined" Color="Color.Error"
                           Disabled="@(_selected.Count != 1)"
                           OnClick="DeleteSelectedAsync">@L["DeleteSelected"]</MudButton>
            }
        </ToolBarContent>
        <HeaderContent>
            <MudTHeadRow Checkable="true">
                <MudTh>@L["Name"]</MudTh>
                <MudTh>@L["Category"]</MudTh>
                <MudTh>@L["Type"]</MudTh>
            </MudTHeadRow>
        </HeaderContent>
        <RowTemplate>
            <MudTd @onclick="@(() => EditAsync(context))">@AttributeLabels.Localize(L, context.Name)</MudTd>
            <MudTd>@context.CategoryName</MudTd>
            <MudTd>@context.DataType</MudTd>
        </RowTemplate>
    </MudTable>
    <MudPagination Count="@Math.Max(1, _page.TotalPages)" Selected="@_page.Page"
                   SelectedChanged="@(async page => await LoadAsync(page))" Class="mt-3" />
}

@code {
    private readonly Dictionary<string, object> TableAttributes = new() { ["aria-label"] = "Attribute catalog" };
    private PagedResult<AttributeDefinitionAdminDto>? _page;
    private IReadOnlyList<AttributeCategoryDto> _categories = [];
    private string? _search;
    private bool _isAdmin;
    private HashSet<AttributeDefinitionAdminDto> _selected = [];

    protected override async Task OnInitializedAsync()
    {
        var catalog = await Catalog.GetCatalogAsync();
        if (catalog.Succeeded)
            _categories = catalog.Value!;
        await LoadAsync(1);
    }

    private async Task LoadAsync(int page)
    {
        var actor = await GetActorAsync();
        _isAdmin = actor.IsAdmin;
        var result = await Definitions.ListAsync(
            actor, new AttributeCatalogQuery(Search: _search, Page: new PageRequest(page, 25)));
        if (result.Succeeded)
            _page = result.Value;
    }

    private async Task SearchChangedAsync(string? value)
    {
        _search = value;
        await LoadAsync(1);
    }

    private async Task CreateAsync() => await OpenDialogAsync(null);

    private async Task EditAsync(AttributeDefinitionAdminDto definition) => await OpenDialogAsync(definition);

    private async Task OpenDialogAsync(AttributeDefinitionAdminDto? editing)
    {
        var parameters = new DialogParameters { [nameof(AttributeDefinitionDialog.Editing)] = editing, [nameof(AttributeDefinitionDialog.Categories)] = _categories };
        var dialog = await DialogService.ShowAsync<AttributeDefinitionDialog>(editing is null ? "New attribute" : "Edit attribute", parameters);
        if ((await dialog.Result) is { Canceled: false })
            await LoadAsync(_page?.Page ?? 1);
    }

    private async Task DeleteAsync(AttributeDefinitionAdminDto definition)
    {
        var actor = await GetActorAsync();
        var impact = await Definitions.GetDeleteImpactAsync(actor, definition.Id);
        if (!impact.Succeeded || impact.Value is null)
            return;
        var i = impact.Value;
        var parameters = new DialogParameters<ConfirmDialog>
        {
            { dialog => dialog.ContentText, $"Delete {definition.Name}? Profiles: {i.ProfileValues}; positions: {i.Positions}; rules: {i.AccessRules}; CVs: {i.Cvs}; restricted positions losing all gating: {i.RestrictedPositionsLosingGating}." },
            { dialog => dialog.YesText, "Delete" },
            { dialog => dialog.NoText, "Cancel" }
        };
        var dialog = await DialogService.ShowAsync<ConfirmDialog>("Delete attribute", parameters);
        if ((await dialog.Result) is not { Canceled: false, Data: true })
            return;
        var result = await Definitions.DeleteAsync(actor, definition.Id, definition.Version);
        if (!result.Succeeded && result.Error.Code == ErrorCodes.ConcurrencyConflict)
            Snackbar.Add(L["ConcurrencyReloadHint"], Severity.Warning);
        else
            Snackbar.Add(result.Succeeded ? "Attribute deleted." : result.Error.Message,
                result.Succeeded ? Severity.Success : Severity.Error);
        await LoadAsync(_page?.Page ?? 1);
    }

    private async Task DeleteSelectedAsync()
    {
        if (_selected.Count != 1)
            return;
        await DeleteAsync(_selected.Single());
        _selected.Clear();
    }

    private async Task<ActorContext> GetActorAsync()
    {
        var state = await AuthProvider.GetAuthenticationStateAsync();
        return new ActorContext(Guid.Parse(state.User.FindFirstValue(ClaimTypes.NameIdentifier)!), state.User.IsInRole(Roles.Admin), state.User.IsInRole(Roles.Recruiter) || state.User.IsInRole(Roles.Admin));
    }
}
