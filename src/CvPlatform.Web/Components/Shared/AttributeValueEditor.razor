@using CvPlatform.Application.Attributes
@using CvPlatform.Core.Enums
@using CvPlatform.Web.Resources
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.Extensions.Localization
@using Microsoft.JSInterop
@inject IJSRuntime Js
@inject IStringLocalizer<SharedResource> L

<div class="cv-attribute-editor" @onfocusout="NotifyChangedAsync">
    @switch (Definition.DataType)
    {
        case AttributeDataType.String:
            <MudTextField T="string" @bind-Value="Value.String"
                          Variant="Variant.Outlined" Immediate="false" Disabled="Disabled" />
            break;
        case AttributeDataType.Text:
            <MudTextField T="string" @bind-Value="Value.Text"
                          Variant="Variant.Outlined" Lines="4" Disabled="Disabled" />
            break;
        case AttributeDataType.Numeric:
            <MudNumericField T="decimal?" @bind-Value="Value.Numeric"
                             Variant="Variant.Outlined" Disabled="Disabled" />
            break;
        case AttributeDataType.Date:
            <MudDatePicker Date="@ToDateTime(Value.Date)"
                           DateChanged="@(date => Value.Date = ToDateOnly(date))"
                           Variant="Variant.Outlined" Disabled="Disabled" />
            break;
        case AttributeDataType.Period:
            <MudStack Row Spacing="2">
                <MudDatePicker Date="@ToDateTime(Value.PeriodStart)"
                               DateChanged="@(date => Value.PeriodStart = ToDateOnly(date))"
                               Label="Start" Variant="Variant.Outlined" Disabled="Disabled" />
                <MudDatePicker Date="@ToDateTime(Value.PeriodEnd)"
                               DateChanged="@(date => Value.PeriodEnd = ToDateOnly(date))"
                               Label="End" Variant="Variant.Outlined" Disabled="Disabled" />
            </MudStack>
            break;
        case AttributeDataType.Boolean:
            <MudSwitch T="bool?" @bind-Value="Value.Boolean"
                       Color="Color.Primary" Disabled="Disabled" />
            break;
        case AttributeDataType.Dropdown:
            <MudSelect T="string" @bind-Value="Value.Dropdown"
                       Variant="Variant.Outlined" Clearable Disabled="Disabled">
                @if (Value.Dropdown is not null && Definition.Choices.All(c => c.Value != Value.Dropdown))
                {
                    <MudSelectItem Value="@Value.Dropdown">@($"{Value.Dropdown} (retired)")</MudSelectItem>
                }
                @foreach (var choice in Definition.Choices)
                {
                    <MudSelectItem Value="@choice.Value">@choice.Value</MudSelectItem>
                }
            </MudSelect>
            break;
        case AttributeDataType.Image:
            @if (Value.ImageValueId is not null)
            {
                <MudImage Src="@ImageContentUrl(Value.ImageValueId.Value)" Alt="Uploaded image" Width="120" Height="120" ObjectFit="ObjectFit.Cover" Class="mb-2" />
            }
            <input @ref="_fileInput" type="file" accept="image/jpeg,image/png,image/webp"
                   disabled="@(Disabled || _uploading)" @onchange="UploadImageAsync" />
            @if (!string.IsNullOrEmpty(_uploadError))
            {
                <MudText Typo="Typo.caption" Color="Color.Error">@_uploadError</MudText>
            }
            break;
    }
</div>

@code {
    [Parameter, EditorRequired] public AttributeDefinitionDto Definition { get; set; } = default!;
    [Parameter, EditorRequired] public AttributeValueDraft Value { get; set; } = default!;
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public EventCallback OnChanged { get; set; }

    private string? _uploadError;
    private bool _uploading;
    private ElementReference _fileInput;
    private const string PresignEndpoint = "/api/profile-images/presign";
    private const string CompleteEndpoint = "/api/profile-images/complete";

    private Task NotifyChangedAsync(FocusEventArgs _) => OnChanged.InvokeAsync();

    private async Task UploadImageAsync(ChangeEventArgs _)
    {
        if (_uploading || Disabled)
            return;
        _uploadError = null;
        _uploading = true;
        try
        {
            await using var module = await Js.InvokeAsync<IJSObjectReference>(
                "import", "./js/directImageUpload.js");
            var objectKey = await module.InvokeAsync<string?>(
                "uploadImage", _fileInput, PresignEndpoint, CompleteEndpoint);
            if (!string.IsNullOrWhiteSpace(objectKey))
            {
                Value.ImageObjectKey = objectKey;
                await OnChanged.InvokeAsync();
            }
        }
        catch (JSException ex)
        {
            _uploadError = string.IsNullOrWhiteSpace(ex.Message)
                ? L["ImageUploadFailed"]
                : $"{L["ImageUploadFailed"]} ({ex.Message})";
        }
        finally
        {
            _uploading = false;
        }
    }

    private static DateTime? ToDateTime(DateOnly? date) =>
        date.HasValue ? date.Value.ToDateTime(TimeOnly.MinValue) : null;

    private static DateOnly? ToDateOnly(DateTime? dateTime) =>
        dateTime.HasValue ? DateOnly.FromDateTime(dateTime.Value) : null;

    private static string ImageContentUrl(Guid valueId) =>
        $"/api/profile-images/{valueId:D}/content";
}
