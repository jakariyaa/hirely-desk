@using CvPlatform.Application.Attributes
@using CvPlatform.Core.Enums
@using CvPlatform.Web.Resources
@using Microsoft.Extensions.Localization

<div class="cv-attribute-editor">
    @if (Definition.DataType == AttributeDataType.Image)
    {
        <ImageUploadField Value="Value" Disabled="Disabled" OnChanged="OnChanged" />
    }
    else
    {
        <div @onfocusout="NotifyChangedAsync">
            @switch (Definition.DataType)
            {
                case AttributeDataType.String:
                    <MudTextField T="string" Value="Value.String"
                                  ValueChanged="@(v => HandleChange(v, s => Value.String = s))"
                                  Variant="Variant.Outlined" Immediate="false" Disabled="Disabled" />
                    break;
                case AttributeDataType.Text:
                    <MudTextField T="string" Value="Value.Text"
                                  ValueChanged="@(v => HandleChange(v, s => Value.Text = s))"
                                  Lines="4"
                                  Variant="Variant.Outlined" Disabled="Disabled" />
                    break;
                case AttributeDataType.Numeric:
                    <MudNumericField T="decimal?" Value="Value.Numeric"
                                     ValueChanged="@(v => HandleChange(v, s => Value.Numeric = s))"
                                     Variant="Variant.Outlined" Disabled="Disabled" />
                    break;
                case AttributeDataType.Date:
                    <MudDatePicker Date="@ToDateTime(Value.Date)"
                                   DateChanged="@(date => HandleChange(date, d => Value.Date = ToDateOnly(d)))"
                                   MinDate="@ToDateTime(MinDate)" MaxDate="@ToDateTime(MaxDate)"
                                   Variant="Variant.Outlined" Disabled="Disabled" />
                    break;
                case AttributeDataType.Period:
                    <MudStack Row Spacing="2">
                        <MudDatePicker Date="@ToDateTime(Value.PeriodStart)"
                                       DateChanged="@(date => HandleChange(date, d => Value.PeriodStart = ToDateOnly(d)))"
                                       MinDate="@ToDateTime(MinDate)" MaxDate="@ToDateTime(MaxDate)"
                                       Label="@L["PeriodStart"]" Variant="Variant.Outlined" Disabled="Disabled" />
                        <MudDatePicker Date="@ToDateTime(Value.PeriodEnd)"
                                       DateChanged="@(date => HandleChange(date, d => Value.PeriodEnd = ToDateOnly(d)))"
                                       MinDate="@ToDateTime(MinDate)" MaxDate="@ToDateTime(MaxDate)"
                                       Label="@L["PeriodEnd"]" Variant="Variant.Outlined" Disabled="Disabled" />
                    </MudStack>
                    break;
                case AttributeDataType.Boolean:
                    <MudSwitch T="bool?" Value="Value.Boolean"
                               ValueChanged="@(v => HandleChange(v, s => Value.Boolean = s))"
                               Color="Color.Primary" Disabled="Disabled" />
                    break;
                case AttributeDataType.Dropdown:
                    <MudSelect T="string" Value="Value.Dropdown"
                               ValueChanged="@(v => HandleChange(v, s => Value.Dropdown = s))"
                               Variant="Variant.Outlined" Clearable Disabled="Disabled">
                        @if (Value.Dropdown is not null && Definition.Choices.All(c => c.Value != Value.Dropdown))
                        {
                            <MudSelectItem Value="@Value.Dropdown">@($"{Value.Dropdown} (retired)")</MudSelectItem>
                        }
                        @foreach (var choice in Definition.Choices)
                        {
                            <MudSelectItem Value="@choice.Value">@choice.Value</MudSelectItem>
                        }
                    </MudSelect>
                    break;
            }
        </div>
    }
    @if (OutOfRangeMessage is not null)
    {
        <MudText Typo="Typo.caption" Color="Color.Error">@OutOfRangeMessage</MudText>
    }
</div>

@code {
    [Parameter, EditorRequired] public AttributeDefinitionDto Definition { get; set; } = default!;
    [Parameter, EditorRequired] public AttributeValueDraft Value { get; set; } = default!;
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public EventCallback OnChanged { get; set; }

    [Inject] private IStringLocalizer<SharedResource> L { get; set; } = default!;

    private DateOnly? MinDate => Definition.DateRange?.Min;

    private DateOnly? MaxDate => Definition.DateRange?.Max ?? Today;

    private DateOnly Today => AttributeDateRules.TodayFrom(null);

    private string? OutOfRangeMessage
    {
        get
        {
            if (Definition.DateRange is null)
                return null;

            var range = new AttributeDateRules.DateRange(MinDate, MaxDate);
            foreach (var date in Dates)
            {
                if (date is null)
                    continue;
                if (date.Value > AttributeDateRules.UpperBound(range, Today) ||
                    (range.Min is { } min && date.Value < min))
                    return L["DateOutOfRange"].Value;
            }

            return null;
        }
    }

    private IEnumerable<DateOnly?> Dates => Definition.DataType switch
    {
        AttributeDataType.Date => [Value.Date],
        AttributeDataType.Period => [Value.PeriodStart, Value.PeriodEnd],
        _ => [],
    };

    private Task NotifyChangedAsync(FocusEventArgs _) => OnChanged.InvokeAsync();

    private Task HandleChange<T>(T value, Action<T> set)
    {
        set(value);
        return OnChanged.InvokeAsync();
    }

    private static DateTime? ToDateTime(DateOnly? date) =>
        date.HasValue ? date.Value.ToDateTime(TimeOnly.MinValue) : null;

    private static DateOnly? ToDateOnly(DateTime? dateTime) =>
        dateTime.HasValue ? DateOnly.FromDateTime(dateTime.Value) : null;
}
