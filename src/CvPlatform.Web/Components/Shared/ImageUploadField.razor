@using CvPlatform.Core.Storage
@using CvPlatform.Web.ErrorHandling
@using CvPlatform.Web.Resources
@using CvPlatform.Web.Storage
@using Microsoft.Extensions.Localization
@implements IDisposable
@inject IImageStorage Images
@inject IImageUploadClient Uploader
@inject AuthenticationStateProvider AuthProvider
@inject IStringLocalizer<SharedResource> L
@inject ErrorMessageLocalizer Messages
@inject IUiErrorReporter Errors

<div class="cv-image-field">
    @if (HasImage)
    {
        <div class="cv-image-preview">
            <MudImage Src="@PreviewUrl" Alt="@L["ImageAlt"]" ObjectFit="ObjectFit.Cover"
                      FallbackSrc="@PlaceholderUrl" />
            @if (_busy)
            {
                <MudOverlay Visible="true" DarkBackground="true" Absolute="true">
                    <MudProgressCircular Color="Color.Secondary" Indeterminate="true" Size="Size.Small" />
                </MudOverlay>
            }
            else if (!Disabled && StorageReady)
            {
                @* Pointer-only shortcut for the drop zone. @aria-label on the input below overrides
                   label-derived naming, so this second label is not announced alongside the first. *@
                <label class="cv-image-preview-edit" title="@L["ImageChange"]" for="@_inputId">
                    <MudIcon Icon="@Icons.Material.Filled.CameraAlt" Size="Size.Small" />
                </label>
            }
        </div>
    }

    <div class="cv-image-dropzone-column">
        <label class="cv-image-dropzone" for="@_inputId">
            <MudIcon Icon="@Icons.Material.Filled.CloudUpload" Color="Color.Primary" />
            <MudText Typo="Typo.body2">@(_busy ? L["ImageUploading"] : L["ImageChooseHere"])</MudText>
            <MudText Typo="Typo.caption" Class="cv-text-caption">@FormatHint</MudText>
            @* @key is bumped after every attempt so the element is recreated empty: a native file
               input keeps its value, so re-picking the same file would not fire change again. *@
            <InputFile @key="_inputGeneration"
                       OnChange="OnFileSelected"
                       id="@_inputId"
                       class="cv-image-sr-only"
                       accept="@Limits.AcceptAttribute"
                       disabled="@(_busy || Disabled || !StorageReady)"
                       aria-label="@L["ImageChooseHere"]"
                       aria-describedby="@(_error is null ? null : _errorId)" />
        </label>

        @if (_busy)
        {
            <div class="cv-image-progress">
                <MudProgressLinear Color="Color.Primary" Size="Size.Small" Value="@_progress" />
                <MudText Typo="Typo.caption" Class="cv-text-caption">
                    @L["ImageProgress", _progress]
                </MudText>
            </div>
            <MudButton Variant="Variant.Text"
                       Color="Color.Error"
                       Size="Size.Small"
                       StartIcon="@Icons.Material.Filled.Close"
                       OnClick="CancelAsync">
                @L["Cancel"]
            </MudButton>
        }
        else if (HasImage)
        {
            <MudButton Variant="Variant.Outlined"
                       Color="Color.Error"
                       Size="Size.Small"
                       StartIcon="@Icons.Material.Filled.Delete"
                       OnClick="RemoveAsync">
                @L["ImageRemove"]
            </MudButton>
        }

        @if (_error is not null)
        {
            <MudAlert id="@_errorId"
                      Severity="Severity.Error"
                      Dense="true"
                      Variant="Variant.Outlined"
                      role="alert">
                @_error
            </MudAlert>
        }
        else if (!StorageReady && !Disabled)
        {
            <MudAlert Severity="Severity.Warning" Dense="true" Variant="Variant.Outlined">
                @L["ImageStorageUnavailable"]
            </MudAlert>
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired] public AttributeValueDraft Value { get; set; } = default!;
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public EventCallback OnChanged { get; set; }

    private const string PlaceholderUrl = "/img/image-placeholder.svg";

    private readonly string _inputId = $"cv-image-{Guid.NewGuid():N}";
    private readonly string _errorId = $"cv-image-error-{Guid.NewGuid():N}";

    private CancellationTokenSource? _upload;
    private bool _busy;
    private bool _disposed;
    private int _progress;
    private int _inputGeneration;
    private string? _error;
    private string? _pendingPreviewUrl;
    private AttributeValueDraft? _uploadedInto;

    /// <summary>
    /// Drops the in-memory preview once the parent replaces the draft, which is how a completed save
    /// (or a reload after a conflict) tells this component the stored image is now authoritative.
    /// </summary>
    protected override void OnParametersSet()
    {
        if (_pendingPreviewUrl is not null && !ReferenceEquals(Value, _uploadedInto))
            _pendingPreviewUrl = null;
    }

    private ImageUploadLimits Limits => new(Images.MaxUploadBytes, Images.AllowedContentTypes);

    private bool StorageReady => Images.IsConfigured;

    private bool HasImage => _pendingPreviewUrl is not null ||
        !string.IsNullOrWhiteSpace(Value.ImageObjectKey);

    private string PreviewUrl => _pendingPreviewUrl ??
        (Value.ImageValueId is Guid id ? ImageContentUrl(id) : PlaceholderUrl);

    private string FormatHint => L[
        "ImageFormatHint",
        string.Join(", ", Images.AllowedContentTypes),
        FormatSize(Images.MaxUploadBytes)];

    public async Task OnFileSelected(InputFileChangeEventArgs args)
    {
        try
        {
            await UploadAsync(args);
        }
        finally
        {
            _busy = false;
            _inputGeneration++;
            // A failed attempt shows nothing; the cancellation branch clears it itself because it
            // leaves no error behind.
            if (_error is not null)
                _pendingPreviewUrl = null;
            StateHasChanged();
        }
    }

    private async Task UploadAsync(InputFileChangeEventArgs args)
    {
        if (_busy || Disabled || !StorageReady)
            return;

        var file = args.File;
        if (file is null)
            return;
        if (!Images.IsAllowedContentType(file.ContentType))
        {
            _error = Messages.DescribeUploadFailure("invalid_type");
            return;
        }
        if (file.Size <= 0 || file.Size > Images.MaxUploadBytes)
        {
            _error = Messages.DescribeUploadFailure("too_large");
            return;
        }

        var actor = ActorContexts.TryFromUser((await AuthProvider.GetAuthenticationStateAsync()).User);
        if (actor is null)
        {
            _error = L["ErrorUnauthorized"];
            return;
        }

        var ticket = Images.CreateUploadTicket(actor.UserId, file.ContentType, file.Size);
        if (ticket is null)
        {
            _error = Messages.DescribeUploadFailure("ticket_failed");
            return;
        }

        _upload?.Cancel();
        _upload?.Dispose();
        _upload = new CancellationTokenSource();
        var cancellationToken = _upload.Token;
        _busy = true;
        _progress = 0;
        _error = null;

        try
        {
            using var buffer = new MemoryStream((int)file.Size);
            await using (var source = file.OpenReadStream(Images.MaxUploadBytes, cancellationToken))
            {
                await source.CopyToAsync(buffer, cancellationToken);
            }
            _pendingPreviewUrl =
                $"data:{file.ContentType};base64,{Convert.ToBase64String(buffer.ToArray())}";
            StateHasChanged();

            buffer.Position = 0;
            var uploaded = await Uploader.PutAsync(
                ticket, buffer, file.Size, ReportProgress, cancellationToken);
            if (!uploaded)
            {
                _error = Messages.DescribeUploadFailure("storage_rejected");
                return;
            }

            var objectKey = await Images.CompleteUploadAsync(
                actor.UserId, ticket.ObjectKey, file.ContentType, file.Size, cancellationToken);
            if (objectKey is null)
            {
                _error = Messages.DescribeUploadFailure("verify_failed");
                return;
            }

            _progress = 100;
            Value.ImageObjectKey = objectKey;
            // The stored value id still points at the previous image until the save round-trips.
            Value.ImageValueId = null;
            _uploadedInto = Value;
            _busy = false;
            StateHasChanged();
            await OnChanged.InvokeAsync();
        }
        catch (OperationCanceledException) when (_upload?.IsCancellationRequested == true)
        {
            // A cancel is not a failure, so there is no error for the finally block to key off.
            _error = null;
            _pendingPreviewUrl = null;
        }
        catch (Exception ex)
        {
            _error = Errors.Report(ex);
        }
    }

    private IProgress<int> ReportProgress => new Progress<int>(percent =>
        _ = InvokeAsync(() =>
        {
            // Progress callbacks already queued on the circuit can outlive the component.
            if (_disposed)
                return;
            _progress = Math.Clamp(percent, 0, 100);
            StateHasChanged();
        }));

    private Task CancelAsync()
    {
        _upload?.Cancel();
        return Task.CompletedTask;
    }

    private Task RemoveAsync()
    {
        _pendingPreviewUrl = null;
        _error = null;
        Value.ImageObjectKey = null;
        Value.ImageValueId = null;
        return OnChanged.InvokeAsync();
    }

    public void Dispose()
    {
        _disposed = true;
        _upload?.Cancel();
        _upload?.Dispose();
    }

    private static string ImageContentUrl(Guid valueId) => $"/api/profile-images/{valueId:D}/content";

    private static string FormatSize(long bytes) => bytes >= 1024 * 1024
        ? $"{bytes / (1024 * 1024)} MB"
        : $"{Math.Max(1, bytes / 1024)} KB";
}